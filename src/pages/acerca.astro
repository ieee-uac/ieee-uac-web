---
import { url } from '../lib/url.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import InfoCard from '../components/InfoCard.astro';
import { site } from '../data/site.js';
---

<BaseLayout
  title="Acerca de | IEEE UAC"
  description="Conoce la Rama Estudiantil IEEE de la Universidad Autónoma del Caribe."
>
<PageHero
  breadcrumbs={[{ label: 'Inicio', href: '/' }, { label: 'Acerca de' }]}
  kicker="Nuestra rama"
  title="IEEE UAC"
  text="IEEE UAC es la rama estudiantil de IEEE en la Universidad Autónoma del Caribe: un punto de encuentro para estudiantes que quieren acercarse al ecosistema profesional de la ingeniería."
/>
<section class="section white"><div class="container"><SectionHead
  kicker="Nuestro propósito"
  title="Experiencias que amplían tu recorrido universitario"
  copy="Aquí los intereses académicos se convierten en práctica, trabajo colaborativo y vínculos con comunidades especializadas dentro y fuera de la universidad."
/><div class="info-grid"><InfoCard icon="E" title="Explorar" text="Descubrir nuevas áreas mediante talleres, charlas, retos y práctica aplicada." /><InfoCard icon="C" title="Colaborar" text="Trabajar con otros estudiantes, capítulos y comunidades en iniciativas con objetivos compartidos." /><InfoCard icon="I" title="Impulsar" text="Proponer ideas, asumir responsabilidades y convertirlas en proyectos con impacto dentro de la rama." /></div></div></section>
<section class="section"><div class="container split-panel"><article class="panel reveal"><span class="section-kicker">Cómo funciona</span><h2>Las iniciativas se construyen en equipo</h2><p>Las propuestas se organizan, se desarrollan y toman forma con el aporte de estudiantes que participan desde distintos intereses y habilidades.</p><a class="btn btn-secondary" href={url('/eventos/')}>Ver actividades</a></article><article class="panel reveal"><span class="section-kicker">Participación</span><h2>Encuentra tu forma de aportar</h2><p>Puedes sumarte desde tus intereses, proponer iniciativas y participar en equipos de trabajo según las oportunidades de cada semestre.</p><a class="btn btn-secondary" href={site.joinForm} target="_blank" rel="noopener noreferrer">Quiero unirme</a></article></div></section>
</BaseLayout>
