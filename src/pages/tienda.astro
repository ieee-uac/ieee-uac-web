---
import { url } from '../lib/url.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProductCard from '../components/ProductCard.astro';
import ShopFilters from '../components/ShopFilters.astro';
import { merch } from '../data/merch.js';

// Categorías únicas, en el orden en que aparecen en el catálogo.
const categories = [...new Set(merch.map((product) => product.category))];
---

<BaseLayout
  title="Tienda | IEEE UAC"
  description="Merch y productos de IEEE UniAutónoma Student Branch."
>
  <PageHero
    class="shop-page-hero"
    breadcrumbs={[{ label: 'Inicio', href: '/' }, { label: 'Tienda' }]}
    kicker="Tienda"
    title="La colección de IEEE UAC"
    text="Prendas, papelería y accesorios pensados para acompañar la vida universitaria y los eventos de la rama. Cada compra se coordina directamente por WhatsApp."
  />

  <section class="section shop-showcase-section">
    <div class="container shop-feature reveal">
      <div class="shop-visual">
        <img src={url('/assets/merch-coleccion.jpg')} alt="Colección de productos IEEE UniAutónoma Student Branch">
        <span class="shop-visual-badge">Colección UAC</span>
      </div>
      <div class="shop-copy-block">
        <span class="section-kicker">Diseño institucional</span>
        <h2>Lleva la rama contigo</h2>
        <p>Piezas pensadas para clases, encuentros y actividades. Antes de cada pedido puedes confirmar disponibilidad, detalles y opciones de entrega por WhatsApp.</p>
        <div class="shop-points">
          <span>Ropa</span>
          <span>Papelería</span>
          <span>Accesorios</span>
        </div>
        <button class="btn btn-primary" type="button" id="generalShopWhatsApp">Comprar por WhatsApp</button>
      </div>
    </div>
  </section>

  <section class="section white">
    <div class="container">
      <div class="shop-catalog-head reveal">
        <div>
          <span class="section-kicker">Catálogo</span>
          <h2 class="section-title">Encuentra lo que buscas</h2>
        </div>
        <ShopFilters categories={categories} />
      </div>
      <div class="shop-grid" id="shopGrid">{merch.map((product) => <ProductCard product={product} />)}</div>
    </div>
  </section>
</BaseLayout>

<script>
  // El mismo módulo de datos que usa el build; aquí se empaqueta para el navegador.
  import { site } from '../data/site.js';

  const openWhatsApp = (message) => {
    const number = (site.whatsappNumber || '').replace(/D/g, '');
    const url = number
      ? `https://wa.me/${number}?text=${encodeURIComponent(message)}`
      : `https://wa.me/?text=${encodeURIComponent(message)}`;
    window.open(url, '_blank', 'noopener,noreferrer');
  };

  // astro:page-load: al entrar a /tienda/ vía <ClientRouter /> (por ejemplo,
  // desde el link "Tienda" del header) hay que reenganchar estos botones.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-product]').forEach((button) => {
      button.addEventListener('click', () => {
        openWhatsApp(`Hola, quiero comprar ${button.dataset.product} de IEEE UAC. ¿Me comparten disponibilidad, valor y opciones de entrega?`);
      });
    });

    document.getElementById('generalShopWhatsApp')?.addEventListener('click', () => {
      openWhatsApp('Hola, quiero conocer la colección de IEEE UAC y las opciones disponibles para comprar.');
    });
  });
</script>
