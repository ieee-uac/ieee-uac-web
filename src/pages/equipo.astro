---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import MemberCard from '../components/MemberCard.astro';
import ProfileDialog from '../components/ProfileDialog.astro';
import { members } from '../data/members.js';
---

<BaseLayout
  title="Junta Directiva | IEEE UAC"
  description="Conoce la Junta Directiva 2026 de IEEE UniAutónoma Student Branch."
>
  <PageHero
    breadcrumbs={[{ label: 'Inicio', href: '/' }, { label: 'Acerca de', href: '/acerca/' }, { label: 'Junta directiva' }]}
    kicker="Junta Directiva 2026"
    title="Nuestro equipo"
    text="La Junta Directiva coordina las actividades y procesos de IEEE UniAutónoma Student Branch. Selecciona un perfil para conocer las responsabilidades de cada cargo."
  />
  <section class="section white"><div class="container"><div class="team-grid" id="teamGrid">{members.map((member) => <MemberCard member={member} />)}</div></div></section>
  <ProfileDialog />
</BaseLayout>
