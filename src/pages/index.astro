---
import { url } from '../lib/url.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import InfoCard from '../components/InfoCard.astro';
import { site } from '../data/site.js';
---

<BaseLayout
  title="IEEE UniAutónoma Student Branch"
  description="Sitio oficial de IEEE UniAutónoma Student Branch de la Universidad Autónoma del Caribe."
>
<section class="hero hero-showcase">
  <div class="container hero-showcase-grid">
    <div class="hero-copy reveal">
      <span class="eyebrow">IEEE · Universidad Autónoma del Caribe</span>
      <h1>Ingeniería que conecta <span>Ideas que toman forma</span></h1>
      <p>Un espacio para ampliar tu experiencia universitaria mediante proyectos, actividades técnicas y vínculos con la comunidad IEEE.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={url('/acerca/')}>Conoce IEEE UAC</a>
        <a class="hero-text-link" href={url('/eventos/')}>Ver actividades <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="hero-stage reveal" aria-hidden="true">
      <div class="hero-ring hero-ring-a"></div>
      <div class="hero-ring hero-ring-b"></div>
      <div class="hero-floating-card">
        <img class="hero-card-logo" src={url('/assets/logo-white.png')} alt="">
        <span class="hero-card-kicker">IEEE UniAutónoma</span>
        <h2>Ingeniería<br>Comunidad<br>Proyección</h2>
        <p>Experiencias que van más allá del aula</p>
      </div>
      <span class="floating-chip chip-events">Talleres</span>
      <span class="floating-chip chip-community">Capítulos</span>
      <span class="floating-chip chip-projects">Proyectos</span>
    </div>
  </div>
</section>

<section class="section white" id="nosotros">
  <div class="container">
    <SectionHead
      kicker="IEEE UAC"
      title="Más allá del aula"
      copy="La rama reúne formación técnica, colaboración entre estudiantes y oportunidades para participar en iniciativas del ecosistema IEEE."
    />
    <div class="info-grid">
      <InfoCard title="Aprendizaje técnico" text="Talleres, charlas y actividades para fortalecer conocimientos y explorar nuevas áreas de la ingeniería." />
      <InfoCard title="Red IEEE" text="Conexiones con estudiantes, profesionales y comunidades que comparten intereses académicos y tecnológicos." />
      <InfoCard title="Experiencia en equipo" text="Proyectos y responsabilidades que permiten desarrollar organización, liderazgo y trabajo colaborativo." />
    </div>
  </div>
</section>

<section class="section">
  <div class="container split-panel">
    <article class="panel red reveal"><span class="section-kicker" style="color:#ffd8dd">Inscripciones</span><h2>Haz parte de la rama</h2><p>Cuéntanos tus áreas de interés y cómo te gustaría participar en las actividades de IEEE UAC.</p><a class="btn btn-secondary" href={site.joinForm} target="_blank" rel="noopener noreferrer">Quiero unirme</a></article>
    <article class="panel reveal"><span class="section-kicker">Estructura</span><h2>Conoce quiénes hacen IEEE UAC</h2><p>Explora la Junta Directiva, IEEE Computer Society y los grupos que impulsan el trabajo de la rama.</p><a class="btn btn-secondary" href={url('/acerca/')}>Ver organización</a></article>
  </div>
</section>

<section class="section white" id="contacto">
  <div class="container contact-grid">
    <div class="contact-card reveal"><span class="section-kicker">Canales oficiales</span><h2>Hablemos</h2><p>Escríbenos para propuestas, alianzas, consultas institucionales o información sobre nuestras actividades.</p><div class="contact-list"><div class="contact-row"><span>Correo</span><a href={`mailto:${site.email}`}>{site.email}</a></div><div class="contact-row"><span>Instagram</span><a href={site.instagram} target="_blank" rel="noopener noreferrer">{site.instagramHandle} ↗</a></div></div></div>
    <div class="contact-card reveal"><span class="section-kicker">Novedades</span><h2>Sigue lo que viene</h2><p>Encuentra convocatorias, eventos, talleres y anuncios de la rama en nuestros canales oficiales.</p><a class="btn btn-primary" href={site.instagram} target="_blank" rel="noopener noreferrer">Ver Instagram</a></div>
  </div>
</section>
</BaseLayout>