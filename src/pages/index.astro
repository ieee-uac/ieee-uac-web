---
import { url } from '../lib/url.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import InfoCard from '../components/InfoCard.astro';
import { site } from '../data/site.js';
---

<BaseLayout
  title="IEEE UniAutónoma Student Branch"
  description="Sitio oficial de IEEE UniAutónoma Student Branch de la Universidad Autónoma del Caribe."
>
<section class="hero hero-showcase">
  <div class="hero-watermark" aria-hidden="true">
    <img src={url('/assets/logo-white.png')} alt="">
  </div>

  <div class="container hero-showcase-grid">
    <div class="hero-copy reveal">
      <span class="eyebrow">IEEE · Universidad Autónoma del Caribe</span>
      <h1>Ideas que conectan <span>Tecnología que transforma</span></h1>
      <p>Construye nuevas experiencias, conecta con una comunidad global y lleva tus ideas más allá del aula.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={url('/acerca/')}>Conócenos</a>
      </div>
    </div>

    <div class="hero-stage reveal" aria-hidden="true">
      <div class="hero-ring hero-ring-a"></div>
      <div class="hero-ring hero-ring-b"></div>
      <div class="hero-floating-card">
        <img class="hero-card-logo" src={url('/assets/logo-white.png')} alt="">
        <h2>Innovación<br>Experiencia<br>Equipo<br>Evolución</h2>
        <div class="hero-card-rule"></div>
        <p>Una comunidad donde las ideas encuentran apoyo, equipo y nuevas posibilidades</p>
      </div>
      <span class="floating-chip chip-community">Capítulos</span>
      <span class="floating-chip chip-projects">Proyectos</span>
      <span class="floating-chip chip-events">Talleres</span>
    </div>
  </div>
</section>

<section class="section white" id="nosotros">
  <div class="container">
    <SectionHead
      kicker="IEEE UAC"
      title="Más allá del aula"
      copy="La rama combina formación técnica, colaboración entre estudiantes y oportunidades para involucrarse en iniciativas del ecosistema IEEE."
    />
    <div class="info-grid">
      <InfoCard title="Aprendizaje técnico" text="Talleres, charlas y actividades para fortalecer conocimientos y explorar nuevas áreas de la ingeniería." />
      <InfoCard title="Red IEEE" text="Conexiones con estudiantes, profesionales y comunidades que comparten intereses académicos y tecnológicos." />
      <InfoCard title="Experiencia en equipo" text="Proyectos y responsabilidades que permiten desarrollar organización, liderazgo y trabajo colaborativo." />
    </div>
  </div>
</section>

<section class="section">
  <div class="container split-panel">
    <article class="panel red reveal"><span class="section-kicker" style="color:#ffd8dd">Inscripciones</span><h2>Encuentra tu lugar en IEEE UAC</h2><p>Cuéntanos qué áreas te interesan y de qué manera te gustaría involucrarte durante el semestre.</p><a class="btn btn-secondary" href={site.joinForm} target="_blank" rel="noopener noreferrer">Quiero unirme</a></article>
    <article class="panel reveal"><span class="section-kicker">Proyección</span><h2>Conecta con el ecosistema IEEE</h2><p>Explora espacios especializados que acercan a la rama con áreas profesionales de la ingeniería y la computación.</p><a class="btn btn-secondary" href={url('/capitulos/')}>Ver IEEE Computer Society</a></article>
  </div>
</section>

<section class="section white" id="contacto">
  <div class="container contact-grid">
    <div class="contact-card reveal"><span class="section-kicker">Contacto institucional</span><h2>Escríbenos</h2><p>Para alianzas, propuestas o consultas relacionadas con IEEE UAC, utiliza nuestro correo oficial.</p><div class="contact-list"><div class="contact-row"><span>Correo</span><a href={`mailto:${site.email}`}>{site.email}</a></div></div></div>
    <div class="contact-card reveal"><span class="section-kicker">Comunidad digital</span><h2>Síguenos de cerca</h2><p>En Instagram compartimos convocatorias, actividades, talleres y novedades de la rama.</p><a class="btn btn-primary" href={site.instagram} target="_blank" rel="noopener noreferrer">Ver Instagram</a></div>
  </div>
</section>
</BaseLayout>