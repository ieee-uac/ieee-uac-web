---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../data/site.js';
---

<BaseLayout
  title="IEEE Computer Society | IEEE UAC"
  description="IEEE Computer Society en IEEE UniAutónoma Student Branch."
>
  <PageHero
    breadcrumbs={[{ label: 'Inicio', href: '/' }, { label: 'Acerca de', href: '/acerca/' }, { label: 'IEEE Computer Society' }]}
    kicker="Capítulo técnico"
    title="IEEE Computer Society"
    text="El espacio de IEEE UAC para quienes quieren profundizar en computación y disciplinas afines."
  />
  <section class="section white"><div class="container"><article class="chapter-card reveal"><div class="chapter-symbol">IEEE<br>CS</div><div><span class="section-kicker">Áreas de interés</span><h2>Del software a la ciberseguridad</h2><p>El capítulo abarca software, sistemas, inteligencia artificial, datos, ciberseguridad y otras áreas de computación. Estas líneas sirven como punto de partida para talleres, proyectos y encuentros especializados dentro de la rama.</p><div class="tags"><span class="tag">Software</span><span class="tag">Inteligencia artificial</span><span class="tag">Datos</span><span class="tag">Ciberseguridad</span><span class="tag">Sistemas</span></div></div></article></div></section>
  <section class="section"><div class="container"><SectionHead
    kicker="¿Te interesa?"
    title="Súmate desde tu área"
    copy="Cuéntanos qué temas quieres explorar para tenerlos en cuenta al momento de proponer nuevas actividades y espacios técnicos."
  /><a class="btn btn-primary" href={site.joinForm} target="_blank" rel="noopener noreferrer">Registrar mis intereses</a></div></section>
</BaseLayout>
