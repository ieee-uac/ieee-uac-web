---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site.js';
---

<BaseLayout
  title="Actividades | IEEE UAC"
  description="Actividades y espacios de formación de IEEE UniAutónoma Student Branch."
>
  <PageHero
    breadcrumbs={[{ label: 'Inicio', href: '/' }, { label: 'Actividades' }]}
    kicker="Actividades"
    title="Ideas en movimiento"
    text="La programación de IEEE UAC combina espacios técnicos, encuentros y retos para convertir los intereses de los estudiantes en experiencias concretas."
  />
  <section class="section white"><div class="container"><div class="activity-grid"><article class="activity-card reveal"><span class="section-kicker">Técnico</span><h3>Talleres aplicados</h3><p>Sesiones para practicar herramientas, conceptos y metodologías vinculadas con ingeniería y computación.</p></article><article class="activity-card reveal"><span class="section-kicker">Encuentros</span><h3>Conversaciones que conectan</h3><p>Charlas y espacios de intercambio con estudiantes, invitados y comunidades que aportan nuevas perspectivas.</p></article><article class="activity-card reveal"><span class="section-kicker">Proyectos</span><h3>Retos e iniciativas</h3><p>Oportunidades para poner ideas a prueba, trabajar en equipo y construir propuestas desde la rama.</p></article></div></div></section>
  <section class="section"><div class="container split-panel"><article class="panel reveal"><span class="section-kicker">Agenda oficial</span><h2>Revisa lo que viene</h2><p>Fechas, inscripciones y novedades se publican en el Instagram oficial de IEEE UAC.</p><a class="btn btn-primary" href={site.instagram} target="_blank" rel="noopener noreferrer">Ver Instagram</a></article><article class="panel reveal"><span class="section-kicker">Propuestas</span><h2>¿Tienes una idea?</h2><p>Si quieres proponer un taller, charla, proyecto o colaboración, escríbenos y cuéntanos tu propuesta.</p><a class="btn btn-secondary" href={`mailto:${site.email}?subject=Propuesta%20para%20IEEE%20UAC`}>Enviar propuesta</a></article></div></section>
</BaseLayout>
