---
import { site } from '../data/site.js';
import { url } from '../lib/url.js';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <div class="footer-brand">
        <img class="footer-logo" src={url('/assets/logo-white.png')} alt={site.name}>
      </div>
      <p>Rama estudiantil IEEE de la Universidad Autónoma del Caribe. Tecnología, innovación, formación y comunidad.</p>
    </div>
    <div class="footer-links">
      <strong>Navegación</strong>
      <a href={url('/acerca/')}>Acerca de</a>
      <a href={url('/equipo/')}>Junta directiva</a>
      <a href={url('/capitulos/')}>Capítulos y grupos</a>
      <a href={url('/eventos/')}>Actividades</a>
      <a href={url('/tienda/')}>Tienda</a>
    </div>
    <div class="footer-links">
      <strong>Canales oficiales</strong>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.instagram} target="_blank" rel="noopener noreferrer">{site.instagramHandle}</a>
      <a href={site.joinForm} target="_blank" rel="noopener noreferrer">Formulario de inscripción</a>
    </div>
  </div>
  <div class="container footer-bottom">© <span id="year"></span> {site.name}</div>
</footer>
